{
  "name": "ritmo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:versions && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/test-database.mjs",
    "test:e2e": "playwright test",
    "test:e2e:local": "playwright test --config=playwright.local.config.ts",
    "test:nutrition:local": "vitest run lib/nutrition/__tests__/local.test.ts lib/nutrition/__tests__/offline.test.ts lib/nutrition/__tests__/portions.test.ts --reporter=verbose",
    "test:nutrition:eval": "RUN_GEMINI_EVAL=1 node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run lib/nutrition/__tests__/reference.eval.test.ts --reporter=verbose",
    "check:versions": "node scripts/check-versions.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
