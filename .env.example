# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Edamam API (opcional, para análisis nutricional avanzado)
EDAMAM_APP_ID=your-app-id
EDAMAM_APP_KEY=your-app-key

# Google AI Studio (opcional). Gemini se ejecuta en el servidor: no uses NEXT_PUBLIC_.
# Crea una clave gratuita en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
# Opcional: modelo de Gemini que usará RITMO para las comidas.
GEMINI_NUTRITION_MODEL=gemini-2.5-flash

# App URL (para CORS y meta tags)
NEXT_PUBLIC_APP_URL=https://ritmo.app
