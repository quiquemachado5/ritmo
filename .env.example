# ============================================================================
# RITMO — variables de entorno
# Copia este archivo como `.env.local` y rellena los valores.
# Sin ninguna de estas variables, RITMO arranca en MODO DEMO (datos locales
# de ejemplo, sin cuentas). Con ellas, activa cuentas y sincronización.
# ============================================================================

# --- Supabase (cuentas + base de datos + sincronización) --------------------
# Project Settings → API en tu proyecto de Supabase.
# La clave anon es pública por diseño: la protege la política RLS del esquema.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Claude API (contador de calorías por lenguaje natural) -----------------
# Sin esta clave, la nutrición usa un estimador offline aproximado.
# Consíguela en https://console.anthropic.com
ANTHROPIC_API_KEY=

# Modelo para el análisis de nutrición (opcional). Por defecto claude-opus-5.
# Para respuestas más rápidas/baratas puedes usar claude-haiku-4-5.
# RITMO_NUTRITION_MODEL=claude-opus-5
