# ============================================================================
# RITMO — variables de entorno
# Copia este archivo como `.env.local` y rellena los valores.
# Supabase es OBLIGATORIO para usar RITMO.
# ============================================================================

# --- Supabase (REQUERIDO) ─────────────────────────────────────────────────
# Cuentas + base de datos + sincronización + autenticación
# Project Settings → API en tu proyecto de Supabase.
# La clave anon es pública por diseño: la protege la política RLS del esquema.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- Nutrición: Edamam API (recomendado) ──────────────────────────────────
# API profesional para análisis nutricional con base de datos de alimentos real
# Registrate en: https://www.edamam.com/nutrition-analysis-api
# Sin credenciales, RITMO usa estimaciones offline (menos precisas)
EDAMAM_APP_ID=
EDAMAM_APP_KEY=
