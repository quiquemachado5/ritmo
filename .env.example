# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Nutrición local: no requiere Gemini, Edamam ni claves administrativas.
# config/nutrition.json bloquea proveedores externos aunque existan claves antiguas.
NUTRITION_AI_ENABLED=false

# App URL (para CORS y meta tags)
NEXT_PUBLIC_APP_URL=https://ritmo.app
